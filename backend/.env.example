KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Same app's admin key, with user unlink API permission. Backend only.
KAKAO_ADMIN_KEY=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/whateat?retryWrites=true&w=majority
MONGODB_DB_NAME=whateat
MONGODB_DNS_SERVERS=
KAKAO_DAILY_LIMIT=99000
KAKAO_COUNTER_TIMEZONE=Asia/Seoul
KAKAO_TIMEOUT_MS=5000
RESTAURANT_CACHE_TTL=3600
RESTAURANT_TARGET_COUNT=200
RESTAURANT_GRID_METERS=50
RESTAURANT_MAX_CALLS=30
RESTAURANT_MAX_DEPTH=4
RESTAURANT_CACHE_MAX_ENTRIES=1000
REDIS_URL=
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Session defaults: 7 days, SameSite=Lax. Secure defaults to true in production.
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=
